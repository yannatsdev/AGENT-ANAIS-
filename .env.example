# GEMINI_API_KEY: Required for Gemini Live (gemini-3.8-live) and summary generation (gemini-4-hydrogen).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_GATEWAY_URL: Optional unified AI Gateway base URL (e.g. Cloudflare AI Gateway, LiteLLM, Portkey, Vercel AI Gateway).
# When set, Gemini and/or OpenAI requests route through this gateway instead of direct provider endpoints.
AI_GATEWAY_URL=

# AI_GATEWAY_API_KEY: Optional API key or Bearer token for your AI Gateway.
AI_GATEWAY_API_KEY=

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VITE_BACKEND_URL: Optional external backend URL (e.g. Cloud Run / Render / Railway)
# when deploying the static frontend separately on Vercel (Vercel does not run persistent WebSocket servers).
VITE_BACKEND_URL=

# ALLOWED_ORIGINS: Optional comma-separated list of frontend origins allowed to call /api/* and /ws/live
# (e.g. "https://mon-app.vercel.app"). Leave empty for same-origin single-host deployments.
ALLOWED_ORIGINS=

